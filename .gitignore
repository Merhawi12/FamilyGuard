# Dependencies
node_modules/

# Environment files — never commit real secrets
.env
.env.local
.env.*.local

# The EAS CLI writes an app.json here when it is run from the repo root instead
# of from an app directory. The real Expo config is
# apps/child-app/{android,ios}/app.config.js; a root one configures nothing and
# only confuses the next person who runs eas.
/app.json

# Build output
dist/
build/
.vite/
*.tsbuildinfo

# …except the desktop projects' `build/`, which is electron-builder's
# *buildResources* directory rather than build output: the installer script, the
# entitlements, the launchd plists and the generated icons all live there and
# all have to be committed. The directory has to be re-included explicitly —
# git will not look inside an excluded directory to find a negated file.
!apps/child-desktop/*/build/

# Firebase CLI upload cache. firebase.json and .firebaserc are committed —
# they are the hosting configuration; this is only a per-machine hash index of
# what was last uploaded.
.firebase/
firebase-debug.log
.runtimeconfig.json

# Terraform — provider binaries, and state/plan files that contain secrets.
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions and
# their checksums, so CI and every machine resolve the same ones.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Real variable values; envs/*.tfvars are committed and hold no secrets.
*.auto.tfvars

# Local databases
*.sqlite
*.sqlite3

# Logs / caches / coverage
*.log
coverage/
.cache/
.nyc_output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# React Native / Expo generated
# One entry per platform project: apps/child-app/{android,ios} are each an Expo
# project root, and the Android one nests its Gradle project a level further in.
apps/child-app/*/.expo/
apps/child-app/android/android/.gradle/
apps/child-app/android/android/app/build/
apps/child-app/android/android/build/
apps/child-app/android/android/local.properties
*.apk
*.aab

# Android release signing — never commit these
keystore.properties
parentix-release.keystore
*.jks

# Firebase per-app config. Downloaded from the console into each android/app/
# directory — docs/DEPLOYMENT.md §2.3a and §2.3b. Not committed: it belongs to
# whichever Firebase project the build targets, not to the repository, and both
# Gradle projects apply the google-services plugin only when it is present.
#
# The API key inside is not a secret in the cryptographic sense — it ships in
# every APK — but it is only safe once restricted to the app's package name and
# signing certificate, and a public repository is a great deal easier to scrape
# than an APK.
google-services.json
# The iOS half of the same thing, downloaded into apps/*/ios/App/App/. Ignored
# for the same reasons, and with one extra: unlike the Android file this one also
# carries the project's GCM sender ID and Google App ID for the *iOS* app, which
# is what an FCM token is minted against.
GoogleService-Info.plist

# Apple signing material — never commit these. The .p8 is the APNs auth key that
# lets FCM deliver to every iOS install of this app; it is downloadable from
# Apple exactly once, and it does not expire, so a leak is permanent until the
# key is revoked by hand.
*.p8
*.p12
*.mobileprovision
*.certSigningRequest

# Capacitor — the Android project is committed (it holds signing and manifest
# configuration), its build output is not.
apps/family-app/android/.gradle/
apps/family-app/android/build/
apps/family-app/android/app/build/
apps/family-app/android/capacitor-cordova-android-plugins/build/
apps/family-app/android/local.properties
# Copied from dist/ by `npx cap sync` on every build.
apps/family-app/android/app/src/main/assets/public/

# The iOS project is committed for the same reason the Android one is: it holds
# the Info.plist, the entitlements and the AppDelegate that bridges APNs to FCM.
#
# Its build output needs no rules here — `npx cap add ios` writes
# apps/family-app/ios/.gitignore covering Pods/, build output, DerivedData and
# the public/ folder copied from dist/. Only the two below are left, because
# they are per-developer Xcode state that can appear outside that directory too.
*.xcuserstate
xcuserdata/
