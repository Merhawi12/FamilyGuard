# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Number of proxy hops in front of Express. 1 behind the Google Cloud load balancer.
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres (Cloud SQL) in every deployed environment. Leave DATABASE_URL blank to
# fall back to the SQLite file at DB_PATH, which is what local dev and tests use.
DATABASE_URL=postgresql://parentix:parentix_secret@localhost:5432/parentix
DB_PATH=./parentix.sqlite

# On Cloud Run the API reaches Cloud SQL over a Unix socket instead, set by
# Terraform. It overrides DATABASE_URL when present, and needs DB_NAME/DB_USER/
# DB_PASSWORD alongside it.
#   DB_SOCKET_PATH=/cloudsql/<project>:<region>:<instance>
DB_SOCKET_PATH=

DB_SSL=false
# Enable once the Cloud SQL server-ca.pem is installed in the image. Not used at
# all over the Unix socket, which is already confined to the instance sandbox.
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_LOGGING=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_32_byte_random_secret
JWT_EXPIRES_IN=7d
MIN_PASSWORD_LENGTH=10

# Field-level encryption for sensitive columns (e.g. activity URLs). 64 hex chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: rotating this makes previously encrypted rows unreadable.
FIELD_ENCRYPTION_KEY=replace_with_64_hex_chars

# ── Allowed browser origins ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Optional comma-separated extras (staging previews, custom domains).
CORS_ORIGINS=

# ── Google Cloud ─────────────────────────────────────────────────────────────
# Inferred from the metadata server on Cloud Run; set it for local runs.
GCP_PROJECT_ID=
GCP_REGION=us-central1

# ── Realtime ─────────────────────────────────────────────────────────────────
# Required once more than one API instance runs, so Socket.IO events reach every
# instance. Leave blank for single-instance or local runs.
REDIS_URL=

# ── Email ────────────────────────────────────────────────────────────────────
# smtp | none  ("none" logs messages instead of sending them)
#
# Google Cloud has no equivalent of SES, so mail goes through an external relay:
# SendGrid, Mailgun, Postmark, Resend or Google Workspace. All speak SMTP.
# Compute Engine blocks outbound port 25 — use 587.
EMAIL_PROVIDER=none
EMAIL_FROM=Parentix <no-reply@parentix.ca>

# Receives contact-form submissions and new-registration notices.
# This is a notification recipient, not a login — see scripts/create-admin.js
# for creating an actual staff account.
ADMIN_EMAIL=merhawigu@gmail.com

# Only used when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── SMS (phone sign-in codes) ────────────────────────────────────────────────
# twilio | none  ("none" logs the code instead of sending it)
#
# Leave this section blank locally. With no provider the API reports phone
# sign-in as available anyway *outside production* and returns the code in the
# response, so the flow can be walked end to end without spending money or
# owning a handset — see SMS_ECHO_CODE below.
#
# In production a blank provider means the Family App hides the Phone tab
# entirely, because a code that cannot be sent is a sign-in that cannot be
# finished. Supply the SID and token, then EITHER a sending number OR a
# messaging service SID — one of the two is required, not both.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Most providers imitate Twilio's REST shape (MessageBird, Plivo, Vonage's
# compatibility endpoint), so pointing this elsewhere is usually the whole of
# switching. Defaults to https://api.twilio.com.
SMS_API_BASE_URL=

# Return the verification code in the HTTP response instead of texting it.
# Defaults to ON in development and OFF everywhere else, and a production boot
# REFUSES TO START if it is set at all — it is a way to sign in as any number
# that can be typed. Automatically inert once real credentials are supplied.
SMS_ECHO_CODE=

# ── File storage ─────────────────────────────────────────────────────────────
# gcs | none  ("none" makes upload endpoints return 503)
#
# Signing needs the service account to hold roles/iam.serviceAccountTokenCreator
# on itself — Application Default Credentials carry no private key, so the client
# signs through the IAM signBlob API.
STORAGE_PROVIDER=none
GCS_BUCKET=
# Cloud CDN domain in front of the bucket; falls back to the direct GCS URL.
GCS_PUBLIC_BASE_URL=
GCS_UPLOAD_URL_TTL=300
MAX_UPLOAD_BYTES=5242880

# ── Push notifications ───────────────────────────────────────────────────────
# Web Push to a parent's browser. Generate the pair once with
#   node scripts/generate-vapid-keys.js
# and keep it: the public key is what browsers subscribe against, so replacing
# it silently invalidates every existing subscription. Leave both blank and the
# API reports push as unavailable rather than half-working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service — a mailto: or https URL. Falls back to ADMIN_EMAIL.
VAPID_SUBJECT=

# Firebase Cloud Messaging, for the parent's Android app. That app is a WebView
# and WebView has no Push API, so the VAPID transport above cannot reach it —
# this is the only route to it.
#
# There is no key here on purpose: sends authenticate with Application Default
# Credentials, which on Cloud Run means the service account and its
# roles/firebasemessaging.admin grant. Locally, `gcloud auth application-default
# login` provides the same thing. Only set this when messaging lives in a
# different Firebase project from GCP_PROJECT_ID, which it normally does not.
FCM_PROJECT_ID=

# Expo push to the child device. The endpoint accepts unauthenticated sends, so
# the access token is only needed once the Expo project enables enhanced security.
EXPO_ACCESS_TOKEN=
# Set to false to record notification attempts in the log without dispatching them.
PUSH_ENABLED=true

# ── Recurring jobs ───────────────────────────────────────────────────────────
# Who runs the hourly safety-analysis pass.
#
#   internal   a setInterval in this process — right for a single long-lived
#              server, and the default
#   external   Cloud Scheduler POSTs /api/tasks/safety-analysis and the
#              in-process timer stays off. What Cloud Run uses, because a
#              throttled instance never fires a timer and six warm ones fire it
#              six times.
JOB_RUNNER=internal
# Required by the task endpoint when JOB_RUNNER=external: the service account
# whose OIDC token it will accept, and the audience that token must carry.
# Terraform sets both. Unset, the endpoint answers 503 rather than running for
# anyone who asks.
SCHEDULER_SERVICE_ACCOUNT=
TASKS_AUDIENCE=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_FAMILY_PRICE_ID=

# ── Sign in with Google ──────────────────────────────────────────────────────
# The OAuth Web client ID. Not a secret — it is public by design — but it is
# load-bearing: it is the audience an incoming Google ID token is checked
# against, and an empty value disables the feature rather than accepting any
# audience. The frontend needs the same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Additional audiences, comma separated. The packaged Android app signs in with
# its own OAuth client, whose tokens carry a different `aud`, so its client ID
# goes here alongside the web one.
GOOGLE_EXTRA_CLIENT_IDS=
