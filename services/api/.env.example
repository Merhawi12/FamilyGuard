# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Number of proxy hops in front of Express. 1 behind the AWS ALB.
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres (RDS) in every deployed environment. Leave DATABASE_URL blank to fall
# back to the SQLite file at DB_PATH, which is what local dev and tests use.
DATABASE_URL=postgresql://parentix:parentix_secret@localhost:5432/parentix
DB_PATH=./parentix.sqlite
DB_SSL=false
# Enable once the RDS CA bundle is installed in the image.
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_LOGGING=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_32_byte_random_secret
JWT_EXPIRES_IN=7d
MIN_PASSWORD_LENGTH=10

# Field-level encryption for sensitive columns (e.g. activity URLs). 64 hex chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: rotating this makes previously encrypted rows unreadable.
FIELD_ENCRYPTION_KEY=replace_with_64_hex_chars

# ── Allowed browser origins ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Optional comma-separated extras (staging previews, custom domains).
CORS_ORIGINS=

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-2

# ── Realtime ─────────────────────────────────────────────────────────────────
# Required once more than one API task runs, so Socket.IO events reach every
# task. Leave blank for single-task or local runs.
REDIS_URL=

# ── Email ────────────────────────────────────────────────────────────────────
# ses | smtp | none  ("none" logs messages instead of sending them)
EMAIL_PROVIDER=none
EMAIL_FROM=Parentix <no-reply@parentix.ca>

# Receives contact-form submissions and new-registration notices.
# This is a notification recipient, not a login — see scripts/create-admin.js
# for creating an actual staff account.
ADMIN_EMAIL=merhawigu@gmail.com

# Only used when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── File storage ─────────────────────────────────────────────────────────────
# s3 | none  ("none" makes upload endpoints return 503)
STORAGE_PROVIDER=none
S3_BUCKET=
# CloudFront domain in front of the bucket; falls back to the direct S3 URL.
S3_PUBLIC_BASE_URL=
S3_UPLOAD_URL_TTL=300
MAX_UPLOAD_BYTES=5242880

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_FAMILY_PRICE_ID=
