# Parentix single-host configuration.
#
#   cp .env.example .env && chmod 600 .env
#
# Both docker-compose.yml and the API container read this file. Never commit the
# filled-in copy — .gitignore already excludes it.

# ── Hostnames ────────────────────────────────────────────────────────────────
# Each must have a DNS A record pointing at this instance's Elastic IP *before*
# the first deploy: Caddy proves control of them over HTTP to get certificates,
# and repeated failures hit a Let's Encrypt rate limit.
APP_DOMAIN=app.parentix.ca
ADMIN_DOMAIN=admin.parentix.ca
# The child app is pinned to this one — see apps/child-app/src/services/api.js.
API_DOMAIN=api.parentix.ca

# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
TLS_EMAIL=you@example.com

# ── Database ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 24
# Changing this after the first run does NOT change the existing database user;
# Postgres only reads it when the data volume is initialised.
POSTGRES_DB=parentix
POSTGRES_USER=parentix
POSTGRES_PASSWORD=

# DATABASE_URL and REDIS_URL are set by docker-compose.yml — do not set them here.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Rotating this logs every user out.
JWT_SECRET=
JWT_EXPIRES_IN=7d
MIN_PASSWORD_LENGTH=10

# Field-level encryption for sensitive columns. Exactly 64 hex characters.
# Generate: openssl rand -hex 32
# WARNING: rotating this makes every already-encrypted row permanently unreadable.
FIELD_ENCRYPTION_KEY=

# ── Browser origins ──────────────────────────────────────────────────────────
# Used for CORS and for the links in password-reset and verification emails, so
# these must be the real public URLs, not localhost.
CLIENT_URL=https://app.parentix.ca
ADMIN_URL=https://admin.parentix.ca
CORS_ORIGINS=

# ── Email ────────────────────────────────────────────────────────────────────
# smtp | none   ("none" logs messages instead of sending them, which means
# password resets and email verification cannot complete — fine for a smoke
# test, not for real users.)
#
# Google Cloud has no equivalent of SES, so mail goes through an external relay:
# SendGrid, Mailgun, Postmark, Resend or Google Workspace. All speak SMTP.
#
# Compute Engine blocks outbound port 25 permanently and silently — use 587.
EMAIL_PROVIDER=none
EMAIL_FROM=Parentix <no-reply@parentix.ca>
ADMIN_EMAIL=merhawigu@gmail.com

# Only when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1

# ── File storage ─────────────────────────────────────────────────────────────
# gcs | none   ("none" makes upload endpoints return 503)
# There is no local-disk provider; uploads need a bucket. Attach a service
# account to the instance rather than putting a key file on disk — and note the
# account needs roles/iam.serviceAccountTokenCreator on itself to sign URLs.
STORAGE_PROVIDER=none
GCS_BUCKET=
GCS_PUBLIC_BASE_URL=
GCS_UPLOAD_URL_TTL=300
MAX_UPLOAD_BYTES=5242880

# ── Stripe ───────────────────────────────────────────────────────────────────
# The webhook endpoint is https://${API_DOMAIN}/api/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_FAMILY_PRICE_ID=

# ── Frontend build-time values ───────────────────────────────────────────────
# Inlined into the JavaScript bundle and visible to anyone — restrict the Maps
# key by HTTP referrer in the Google Cloud console.
VITE_GOOGLE_MAPS_KEY=

# ── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/parentix
BACKUP_KEEP_DAYS=14
# Optional off-box copy, e.g. gs://parentix-backups. Needs gsutil (preinstalled
# on GCE images) and a service account with roles/storage.objectCreator.
# Without this, a lost persistent disk is a lost database.
BACKUP_GCS_URI=

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
DB_POOL_MAX=10
DB_LOGGING=false
