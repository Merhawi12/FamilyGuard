# Origin of the Parentix API.
#
# Leave blank in every environment where the API is reachable on the same origin:
# locally the Vite dev proxy forwards /api and /socket.io to http://localhost:5000,
# and in production CloudFront routes /api/* and /socket.io/* to the ALB.
VITE_API_URL=

# Google Maps JavaScript API key used by the Location page.
VITE_GOOGLE_MAPS_KEY=

# Origin of the Admin Dashboard — staff see a link to it in the sidebar.
VITE_ADMIN_URL=http://localhost:3001
