# Origin of the Parentix API.
#
# Leave blank locally: the Vite dev proxy forwards /api and /socket.io to
# http://localhost:5000, so the app and the API share an origin.
#
# In production they do not. Firebase Hosting serves this app and Cloud Run
# serves the API, so the value has to name the API host and the API has to list
# this app's origin in CORS_ORIGINS. scripts/deploy-web.sh reads it from the
# Terraform `api_url` output rather than from whoever runs the release.
#
# Production: VITE_API_URL=https://api.parentix.ca
VITE_API_URL=

# Google Maps JavaScript API key used by the Location page. Optional: with no
# key the page draws the same map, its safe zones and its marker from
# OpenStreetMap tiles instead, and looks addresses up against Nominatim. Set one
# only if you want Google's basemap and geocoder — and if you do, enable both
# the Maps JavaScript API *and* the Geocoding API on it.
#
# Without a key nothing is requested from Google at all: the Maps script is only
# loaded when there is a key to load it with.
VITE_GOOGLE_MAPS_KEY=

# Where the keyless map fetches its tiles. Defaults to OpenStreetMap's public
# servers, whose usage policy covers a service of this size but rules out heavy,
# systematic traffic — point these at your own or a paid provider before that
# becomes you. Any {z}/{x}/{y} raster source works.
#
#   VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
#   VITE_MAP_TILE_ATTRIBUTION=&copy; Example Maps
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Origin of the Admin Dashboard — staff see a link to it in the sidebar.
VITE_ADMIN_URL=http://localhost:3001

# Sign in with Google — the OAuth *Web* client ID from the Google Cloud console
# (APIs & Services → Credentials). Public: it ships in the bundle and is sent to
# Google in the clear. Safety comes from the API checking Google's signature on
# the returned ID token against this same ID, not from hiding it.
#
# Leave empty and the Google button is not rendered at all. The API must be told
# the same ID (GOOGLE_CLIENT_ID) or it will refuse the token the button produces.
#
# Authorised JavaScript origins must list every host that serves this app:
#   https://parentix.ca  https://www.parentix.ca  https://app.parentix.ca
#   https://parentix-4be0d.web.app  http://localhost:3000
#
# No client in this project carries all five today. Production's (…iqb08gu4…, in
# infrastructure/gcp/envs/prod.tfvars) has the four public hostnames and refuses
# http://localhost:3000, so leave this empty for local work: a client whose
# origins do not include your dev origin still draws the button and then fails
# on click with `400 origin_mismatch`, and drawing the button is not the same
# check as allowing the sign-in. Whatever you set, services/api/.env must name
# the same ID as GOOGLE_CLIENT_ID or the API refuses the token it produces.
VITE_GOOGLE_CLIENT_ID=
