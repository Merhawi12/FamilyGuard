<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores leaves the device.

  `android:allowBackup="false"` on the application tag already turns off cloud
  backup, but on Android 12 and later that flag no longer governs device-to-device
  transfer — this file does, and the two have to say the same thing or a phone
  restored from another phone carries data the cloud path refuses.

  What is at stake is concrete rather than theoretical. This app is a Capacitor
  WebView, so the parent's session JWT lives in the WebView's localStorage inside
  the app's data directory. Under the default `allowBackup="true"` that directory
  is uploaded to the account holder's Google Drive and restored onto whatever
  device signs in next — a bearer credential for a family's children's location
  history, travelling somewhere nobody chose to send it and outliving a sign-out
  on the original handset.

  There is nothing here worth backing up in any case: every piece of state is on
  the server and arrives again on the next sign-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
        <exclude domain="device_file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
        <exclude domain="device_file" />
    </device-transfer>
</data-extraction-rules>
