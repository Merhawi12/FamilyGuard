# Backend the child device app talks to.
#
# The child app connects to the API hostname directly (api.parentix.ca), not
# through the app hostnames that serve the web apps.
#
# Expo SDK 50 inlines every EXPO_PUBLIC_* variable into the bundle at build
# time, so changing these requires a rebuild — installed apps will not pick up
# a new value at runtime.
EXPO_PUBLIC_API_URL=https://api.parentix.ca/api
EXPO_PUBLIC_SOCKET_URL=https://api.parentix.ca

# Local development against a machine on the same network:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.10:5000
