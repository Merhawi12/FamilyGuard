<?xml version="1.0" encoding="utf-8"?>
<!--
  The round variant, identical to ic_launcher.xml on purpose.

  An adaptive icon is already shape-agnostic — the launcher applies its own mask,
  circular or otherwise — so the two differ only in which name a launcher asks
  for. Pointing both at the same layers is what keeps a circular launcher and a
  squircle one showing the same icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/iconBackground"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
