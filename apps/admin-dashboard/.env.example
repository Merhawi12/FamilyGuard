# Origin of the Parentix API.
#
# Leave blank locally: the Vite dev proxy (see vite.config.js) forwards /api and
# /socket.io to http://localhost:5000, so the console and the API share an origin.
#
# In production they do not — Firebase Hosting serves the console and Cloud Run
# serves the API — so this names the API host and the API must list the console's
# origin in CORS_ORIGINS.
#
# Production: VITE_API_URL=https://api.parentix.ca
VITE_API_URL=
